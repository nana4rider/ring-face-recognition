{
  "name": "ring-face-recognition",
  "version": "2.0.1",
  "author": "nana4rider",
  "license": "ISC",
  "main": "dist/index.js",
  "type": "module",
  "homepage": "https://github.com/nana4rider/ring-face-recognition",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node dist/index",
    "build": "node build.js",
    "type-check": "tsc",
    "lint": "eslint --max-warnings 0 && prettier . --check",
    "lint:fix": "eslint --fix && prettier . --write",
    "test": "vitest run",
    "prepare": "lefthook install || true",
    "token": "npx -p ring-client-api ring-auth-cli"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1156.0",
    "dayjs": "^1.11.23",
    "envalid": "^9.0.0",
    "gm": "^1.25.1",
    "ring-client-api": "^14.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/gm": "^1.25.4",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^24.19.2",
    "@types/socket.io-client": "^3.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lefthook": "^2.1.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
